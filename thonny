# Inisialisasi pin
TRIG = Pin(23, Pin.OUT)
ECHO = Pin(22, Pin.IN)
DHT_PIN = Pin(15)
dht_sensor = dht.DHT11(DHT_PIN)

LED_MERAH = Pin(18, Pin.OUT)
LED_KUNING = Pin(19, Pin.OUT)
LED_HIJAU = Pin(21, Pin.OUT)

# Koneksi ke WiFi
def connect_wifi():
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    if not wlan.isconnected():
        print('Menghubungkan ke WiFi...')
        wlan.connect(SSID, PASSWORD)
        while not wlan.isconnected():
            time.sleep(1)
    print('Terhubung ke WiFi:', wlan.ifconfig())

# Ukur jarak
def measure_distance():
    TRIG.off()
    time.sleep_us(2)
    TRIG.on()
    time.sleep_us(10)
    TRIG.off()
    
    try:
        duration = time_pulse_us(ECHO, 1, 30000)
        distance_cm = (duration * 0.0343) / 2
        return distance_cm
    except OSError:
        print("Timeout pembacaan jarak")
        return None

# Baca DHT11
def read_dht():
    try:
        dht_sensor.measure()
        suhu = dht_sensor.temperature()
        kelembapan = dht_sensor.humidity()
        return suhu, kelembapan
    except Exception as e:
        print("Gagal membaca DHT11:", e)
        return None, None

# Kontrol LED
def set_led(jarak):
    if jarak is None:
        LED_MERAH.off()
        LED_KUNING.off()
        LED_HIJAU.off()
    elif jarak < 20:
        LED_MERAH.on()
        LED_KUNING.off()
        LED_HIJAU.off()
    elif jarak < 50:
        LED_MERAH.off()
        LED_KUNING.on()
        LED_HIJAU.off()
    else:
        LED_MERAH.off()
        LED_KUNING.off()
        LED_HIJAU.on()

# Kirim ke Ubidots
def kirim_ubidots(jarak, suhu, kelembapan):
    data = {
        "jarak": jarak,
        "suhu": suhu,
        "kelembapan": kelembapan
    }
    headers = {
        "X-Auth-Token": UBIDOTS_TOKEN,
        "Content-Type": "application/json"
    }
    try:
        response = urequests.post(UBIDOTS_URL, json=data, headers=headers)
        print("Response Ubidots:", response.text)
        response.close()
    except Exception as e:
        print("Gagal kirim ke Ubidots:", e)

# Kirim pesan ke Telegram
def send_telegram(message):
    data = {
        'chat_id': CHAT_ID,
        'text': message
    }
    try:
        response = urequests.post(TELEGRAM_URL, json=data)
        print("Telegram response:", response.text)
        response.close()
    except Exception as e:
        print("Gagal kirim Telegram:", e)

